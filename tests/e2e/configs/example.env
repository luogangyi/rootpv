# 测试环境示例。复制为 .ebs-cluster.env 后按实际环境修改；该本地文件已被 Git 忽略。
# 请勿保存 SSH 密码、镜像仓库密码、访问令牌或 kubeconfig。
SSH_HOST=kubernetes-control-plane.example.com
SSH_PORT=22
SSH_USER=root
TEST_ENVIRONMENT_SUMMARY='Kubernetes v1.29.x；多节点 x86_64 Linux 集群；目标节点使用 containerd'
STORAGE_SUMMARY='动态块存储 PVC'
TEST_IMAGE_SUMMARY='可拉取或已预加载的 RootPV 测试镜像'

# 已部署 RootPV 的组件信息与可运行 RootPV workload 的节点。
ROOTPV_NAMESPACE=rootpv-system
ROOTPV_CONTROLLER_DEPLOYMENT=persistent-rootfs-controller
ROOTPV_DAEMONSET=persistent-rootfsd
TEST_NODE=rootpv-worker-1
EXPECTED_RUNTIME_CLASS=persistent-rootfs-node-default
EXPECTED_RUNTIME_ADAPTER=runc-v2

# 测试资源名称必须使用 rootpv-e2e- 或 rootpv-test- 前缀。
TEST_NAMESPACE=rootpv-e2e-example
TEST_PVC_NAME=rootpv-e2e-data
TEST_CONTAINER_NAME=app
TEST_VOLUME_NAME=rootfs-data
STORAGE_CLASS=block-storage
PVC_SIZE=10Gi

# 镜像应可由测试节点拉取，或在执行前预加载到目标节点的 containerd。
TEST_IMAGE=registry.example.com/rootpv:test
TEST_IMAGE_PULL_POLICY=IfNotPresent

# 功能测试参数。
FUNCTIONAL_ROOTFS_PATH=e2e/functional
FUNCTIONAL_MARKER_PATH=/rootpv-e2e.marker
FUNCTIONAL_FIRST_MARKER=first-generation
FUNCTIONAL_SECOND_MARKER=second-generation
INVALID_ROOTFS_CONTAINER=missing-container
NON_ROOTPV_POD_NAME=rootpv-functional-standard
INVALID_POD_NAME=rootpv-functional-invalid

# 性能测试参数。
PERF_ROOTFS_PATH=performance/default
PERF_WARMUP_ITERATIONS=1
PERF_BASELINE_ITERATIONS=3
PERF_ITERATIONS=3
PERF_WRITE_MIB=64
PERF_FILE_PATH=/rootpv-performance.bin

# 等待、清理与结果记录参数。
POD_START_TIMEOUT=360s
POD_DELETE_TIMEOUT=300s
POD_SLEEP_SECONDS=600
CLEANUP=true
RESULTS_DIR=tests/e2e/results
